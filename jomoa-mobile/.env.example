# ─────────────────────────────────────────────────────────────
# User DB (persondata)
# ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_USER_SUPABASE_URL=https://<user-project>.supabase.co
EXPO_PUBLIC_USER_SUPABASE_ANON_KEY=your-user-db-anon-key-here

# ─────────────────────────────────────────────────────────────
# Content DB (exercises, programs, session_templates, etc.)
# ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_CONTENT_SUPABASE_URL=https://<content-project>.supabase.co
EXPO_PUBLIC_CONTENT_SUPABASE_ANON_KEY=your-content-db-anon-key-here

# ─────────────────────────────────────────────────────────────
# Portfolio demo (Expo Web)
# ─────────────────────────────────────────────────────────────
# Enables a public, no-login demo that seeds a local "client" persona.
# Recommended for portfolio deployments (use a demo Supabase project for content).
EXPO_PUBLIC_DEMO_MODE=false
# strength_3x | cycle_only | perimenopause
EXPO_PUBLIC_DEMO_PERSONA=strength_3x

# Optional: crash reporting (leave empty to disable)
# EXPO_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
